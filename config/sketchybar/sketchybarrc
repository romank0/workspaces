#!/usr/bin/env bash
# ABOUTME: Main SketchyBar configuration for workspace-centric environment.
# ABOUTME: Registers Aerospace events, workspace display, and system indicators.

PLUGIN_DIR="$CONFIG_DIR/plugins"
# Resolve symlink to find actual repo location
REAL_CONFIG_DIR="$(cd -P "$CONFIG_DIR" && pwd)"
REPO_DIR="$(cd "$REAL_CONFIG_DIR/../.." && pwd)"

# --- Remove all default items ---
sketchybar --remove '/.*/' 2>/dev/null || true

# --- Bar appearance ---
sketchybar --bar \
    position=top \
    height=32 \
    blur_radius=30 \
    color=0x40000000

# --- Default item styling ---
default=(
    padding_left=3
    padding_right=3
    icon.font="Hack Nerd Font:Bold:14.0"
    label.font="Hack Nerd Font:Bold:14.0"
    icon.color=0xffffffff
    label.color=0xffffffff
    icon.padding_left=3
    icon.padding_right=3
    label.padding_left=3
    label.padding_right=3
)
sketchybar --default "${default[@]}"

# --- Aerospace workspace change event ---
sketchybar --add event aerospace_workspace_change
sketchybar --add event cast_mode_change

# --- Single trigger item that refreshes workspaces on change ---
sketchybar --add item ws_trigger left \
           --set ws_trigger drawing=off script="$PLUGIN_DIR/workspaces.sh" \
           --subscribe ws_trigger aerospace_workspace_change

# --- Right side: clock, volume, wifi, bluetooth, keyboard, battery, vpn, slack, mail ---
sketchybar --add item clock right \
           --set clock update_freq=10 icon= label.font="SF Pro:Semibold:13.0" script="$PLUGIN_DIR/clock.sh" \
           --add item volume right \
           --set volume update_freq=5 label.font="SF Pro:Semibold:13.0" script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change \
           --add item wifi right \
           --set wifi update_freq=5 icon="󰖩" label.drawing=off \
                     script="$PLUGIN_DIR/wifi.sh" \
           --add item bluetooth right \
           --set bluetooth update_freq=5 icon="󰂯" label.drawing=off \
                     script="$PLUGIN_DIR/bluetooth.sh" \
           --add item keyboard right \
           --set keyboard update_freq=2 icon.drawing=off label.font="SF Pro:Semibold:13.0" \
                     background.drawing=on background.color=0xff2d333b background.corner_radius=4 \
                     background.height=20 background.padding_left=4 background.padding_right=4 \
                     script="$PLUGIN_DIR/keyboard.sh" \
           --add item battery right \
           --set battery update_freq=120 label.font="SF Pro:Semibold:13.0" script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change \
           --add item cast right \
           --set cast icon="󰄝" label.drawing=off drawing=off \
                     script="$PLUGIN_DIR/cast.sh" \
           --subscribe cast cast_mode_change \
           --add item vpn right \
           --set vpn update_freq=5 icon="󰦝" label.padding_left=2 \
                     script="$PLUGIN_DIR/vpn.sh" \
           --add item slack right \
           --set slack update_freq=5 icon="󰒱" label.padding_left=2 \
                     script="$PLUGIN_DIR/slack.sh" \
           --add item mail right \
           --set mail update_freq=5 icon="󰇮" label.padding_left=2 \
                     script="$PLUGIN_DIR/mail.sh"

# --- Initial workspace sync ---
"$REPO_DIR/bin/ws-sync"

# --- Force all scripts to run ---
sketchybar --update
