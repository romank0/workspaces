#!/usr/bin/env bash
# ABOUTME: Toggles workspace alert state for SketchyBar highlighting.
# ABOUTME: Writes/removes a state file that ws-sync reads during bar rebuild.

set -euo pipefail

STATE_DIR="${WS_ALERT_STATE_DIR:-$HOME/.local/state/workspaces}"
ALERT_DIR="$STATE_DIR/alerts"
SESSION_DIR="$STATE_DIR/sessions"

usage() {
    echo "Usage: ws-alert on [SLOT]        — mark slot as alerting (default: session's workspace)"
    echo "       ws-alert off [SLOT]       — clear alert for slot (default: session's workspace)"
    echo "       ws-alert register [SLOT]  — save workspace for this session (default: detect)"
    echo "       ws-alert unregister       — remove session and clear its alert"
    echo "       ws-alert status           — exit 0 if any alert active, 1 if not"
    exit 1
}

# Find the workspace of the terminal window running this process.
# Uses iTerm2 session ID to look up the macOS window ID, then maps it
# to an Aerospace workspace. Falls back to the focused workspace.
detect_terminal_workspace() {
    if [[ -n "${ITERM_SESSION_ID:-}" ]]; then
        local session_uuid="${ITERM_SESSION_ID#*:}"
        local window_id
        window_id=$(osascript -e "
            tell application \"iTerm2\"
                repeat with w in windows
                    repeat with t in tabs of w
                        repeat with s in sessions of t
                            if unique ID of s is \"$session_uuid\" then
                                return id of w
                            end if
                        end repeat
                    end repeat
                end repeat
            end tell
        " 2>/dev/null) || true

        if [[ -n "$window_id" ]]; then
            local workspace
            workspace=$(aerospace list-windows --monitor all --json \
                --format '%{window-id}%{tab}%{workspace}' | \
                jq -r --argjson wid "$window_id" \
                '.[] | select(.["window-id"] == $wid) | .workspace')
            if [[ -n "$workspace" ]]; then
                echo "$workspace"
                return
            fi
        fi
    fi

    aerospace list-workspaces --focused
}

session_key() {
    echo "${WS_ALERT_SESSION_KEY:-${ITERM_SESSION_ID:-$$}}"
}

# Look up saved workspace for this session, fall back to detection
session_workspace() {
    local key
    key=$(session_key)
    local session_file="$SESSION_DIR/$key"
    if [[ -f "$session_file" ]]; then
        cat "$session_file"
        return
    fi
    detect_terminal_workspace
}

refresh_bar() {
    if [[ -z "${WS_ALERT_SKIP_REFRESH:-}" ]]; then
        sketchybar --trigger aerospace_workspace_change 2>/dev/null || true
    fi
}

[[ $# -ge 1 ]] || usage

case "$1" in
    on)
        slot="${2:-$(session_workspace)}"
        mkdir -p "$ALERT_DIR"
        touch "$ALERT_DIR/$slot"
        refresh_bar
        ;;
    off)
        slot="${2:-$(session_workspace)}"
        rm -f "$ALERT_DIR/$slot"
        refresh_bar
        ;;
    register)
        slot="${2:-$(detect_terminal_workspace)}"
        mkdir -p "$SESSION_DIR"
        echo "$slot" > "$SESSION_DIR/$(session_key)"
        ;;
    unregister)
        local_key=$(session_key)
        if [[ -f "$SESSION_DIR/$local_key" ]]; then
            slot=$(cat "$SESSION_DIR/$local_key")
            rm -f "$ALERT_DIR/$slot"
            rm -f "$SESSION_DIR/$local_key"
            refresh_bar
        fi
        ;;
    status)
        [[ -d "$ALERT_DIR" ]] && [[ -n "$(ls -A "$ALERT_DIR" 2>/dev/null)" ]]
        ;;
    *)
        usage
        ;;
esac
