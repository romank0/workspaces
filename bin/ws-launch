#!/usr/bin/env bash
# ABOUTME: Launches a workspace from a template into an Aerospace slot.
# ABOUTME: Opens apps with arguments and stores the display name for SketchyBar.

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
TEMPLATES_FILE="${TEMPLATES_FILE:-$REPO_DIR/templates/workspaces.yaml}"
# shellcheck source=../lib/name-store.sh
source "$REPO_DIR/lib/name-store.sh"
MAX_WAIT_SECONDS=10

log() { printf '%s\n' "$*"; }
warn() { printf 'WARNING: %s\n' "$*" >&2; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

chrome_local_state_path() {
    echo "${CHROME_LOCAL_STATE:-$HOME/Library/Application Support/Google/Chrome/Local State}"
}

resolve_chrome_profile() {
    local display_name="$1"
    local local_state
    local_state=$(chrome_local_state_path)
    python3 -c "
import json, sys
with open('''$local_state''') as f:
    data = json.load(f)
cache = data.get('profile', {}).get('info_cache', {})
for dir_name, info in cache.items():
    if info.get('name') == '''$display_name''':
        print(dir_name)
        sys.exit(0)
available = [info.get('name', d) for d, info in cache.items()]
print(f\"Chrome profile '$display_name' not found. Available: {', '.join(available)}\", file=sys.stderr)
sys.exit(1)
"
}

list_chrome_profiles() {
    local local_state
    local_state=$(chrome_local_state_path)
    python3 -c "
import json, sys
with open('''$local_state''') as f:
    data = json.load(f)
cache = data.get('profile', {}).get('info_cache', {})
for info in cache.values():
    print(info.get('name', ''))
"
}

profiles_by_tag() {
    local tag="$1"
    python3 -c "
import plistlib, subprocess, sys
out = subprocess.run(['defaults', 'export', 'com.googlecode.iterm2', '-'], capture_output=True)
data = plistlib.loads(out.stdout)
for p in data.get('New Bookmarks', []):
    if '$tag' in p.get('Tags', []):
        print(p['Name'])
"
}

pick_iterm_profile() {
    local tag="$1"
    local profiles
    profiles=$(profiles_by_tag "$tag")

    # Always include Default profile
    if [[ -n "$profiles" ]]; then
        if ! echo "$profiles" | grep -qx "Default"; then
            profiles="Default"$'\n'"$profiles"
        fi
    else
        profiles="Default"
    fi

    local count
    count=$(echo "$profiles" | wc -l | tr -d ' ')
    if [[ "$count" -eq 1 ]]; then
        echo "$profiles"
    else
        echo "$profiles" | choose -p "iTerm2 profile:" -n 10 || exit 0
    fi
}

usage() {
    echo "Usage: ws-launch <template> <slot> [display-name]"
    echo ""
    echo "  template      Template name from workspaces.yaml"
    echo "  slot          Aerospace workspace slot (1-9, A-Z)"
    echo "  display-name  Optional name shown in SketchyBar (default: template name)"
    echo ""
    echo "Available templates:"
    yq 'keys | .[]' "$TEMPLATES_FILE" 2>/dev/null | sed 's/^/  /'
    exit 1
}

current_window_ids() {
    aerospace list-windows --all --json --format '%{window-id}' \
        | jq -r '.[].["window-id"]' 2>/dev/null || true
}

# Captures window-id → workspace mapping for a given app
snapshot_app_windows() {
    local app_name="$1"
    aerospace list-windows --all --json --format '%{window-id}%{tab}%{app-name}%{tab}%{workspace}' \
        | jq -r --arg app "$app_name" \
            '.[] | select(.["app-name"] == $app) | "\(.["window-id"]) \(.workspace)"' 2>/dev/null || true
}

# Restores displaced windows to their original workspaces
restore_displaced_windows() {
    local app_name="$1"
    local original_positions="$2"

    [[ -n "$original_positions" ]] || return 0

    local current_positions
    current_positions=$(snapshot_app_windows "$app_name")

    while IFS=' ' read -r wid orig_ws; do
        local cur_ws
        cur_ws=$(echo "$current_positions" | awk -v id="$wid" '$1 == id { print $2 }')
        if [[ -n "$cur_ws" && "$cur_ws" != "$orig_ws" ]]; then
            log "Restoring $app_name window $wid from $cur_ws back to $orig_ws"
            aerospace move-node-to-workspace "$orig_ws" --window-id "$wid" 2>/dev/null || true
        fi
    done <<< "$original_positions"
}

wait_for_new_window() {
    local before_ids="$1"
    local app_name="$2"
    local elapsed=0

    while [[ $elapsed -lt $MAX_WAIT_SECONDS ]]; do
        sleep 0.5
        elapsed=$((elapsed + 1))

        local new_id
        new_id=$(aerospace list-windows --all --json --format '%{window-id}%{tab}%{app-name}' \
            | jq -r --arg app "$app_name" \
                '.[] | select(.["app-name"] == $app) | .["window-id"]' 2>/dev/null \
            | while IFS= read -r wid; do
                if ! echo "$before_ids" | grep -qx "$wid"; then
                    echo "$wid"
                    break
                fi
            done)

        if [[ -n "$new_id" ]]; then
            echo "$new_id"
            return 0
        fi
    done

    return 1
}

launch_app() {
    local slot="$1"
    local app_name="$2"
    local iterm_profile="$3"
    local chrome_profile_dir="$4"
    shift 4
    local args=("$@")

    local before_ids
    before_ids=$(current_window_ids)
    local original_positions
    original_positions=$(snapshot_app_windows "$app_name")

    log "Launching $app_name..."

    # Extract URLs from args
    local urls=()
    local other_args=()
    for arg in "${args[@]}"; do
        if [[ "$arg" =~ ^https?:// ]]; then
            urls+=("$arg")
        else
            other_args+=("$arg")
        fi
    done

    if [[ -n "$iterm_profile" ]]; then
        osascript -e "tell application \"iTerm\" to create window with profile \"$iterm_profile\"" 2>/dev/null || {
            warn "Failed to create iTerm window with profile '$iterm_profile'"
            return 1
        }
    elif [[ -n "$chrome_profile_dir" ]]; then
        local chrome_bin="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
        local chrome_args=("--profile-directory=$chrome_profile_dir")
        if [[ ${#urls[@]} -gt 0 ]]; then
            chrome_args+=("--new-window" "${urls[0]}")
        fi
        "$chrome_bin" "${chrome_args[@]}" &>/dev/null &
        disown
    elif [[ ${#urls[@]} -gt 0 ]]; then
        local url="${urls[0]}"
        osascript \
            -e "tell application \"$app_name\"" \
            -e "    set newWindow to make new window" \
            -e "    set URL of active tab of newWindow to \"$url\"" \
            -e "end tell" 2>/dev/null || {
            warn "Failed to create $app_name window with URL"
            return 1
        }
    elif [[ ${#other_args[@]} -gt 0 ]]; then
        open -a "$app_name" --args "${other_args[@]}" 2>/dev/null || {
            warn "Failed to launch $app_name"
            return 1
        }
    else
        osascript -e "tell application \"$app_name\" to make new window" 2>/dev/null \
            || osascript -e "tell application \"$app_name\" to create window with default profile" 2>/dev/null \
            || open -a "$app_name" 2>/dev/null \
            || { warn "Failed to launch $app_name"; return 1; }
    fi

    local new_window_id
    if new_window_id=$(wait_for_new_window "$before_ids" "$app_name"); then
        aerospace move-node-to-workspace "$slot" --window-id "$new_window_id" 2>/dev/null || {
            warn "Failed to move $app_name window to workspace $slot"
        }
    else
        warn "Timed out waiting for $app_name window"
    fi

    restore_displaced_windows "$app_name" "$original_positions"
}

main() {
    [[ $# -ge 2 ]] || usage

    local template="$1"
    local slot
    slot=$(echo "$2" | tr '[:lower:]' '[:upper:]')
    local display_name="${3:-$template}"

    command -v aerospace >/dev/null 2>&1 || die "aerospace not found"
    command -v yq >/dev/null 2>&1 || die "yq not found"
    aerospace list-workspaces --focused >/dev/null 2>&1 || die "Aerospace is not running"
    [[ -f "$TEMPLATES_FILE" ]] || die "Templates file not found: $TEMPLATES_FILE"

    local tmpl_exists
    tmpl_exists=$(yq "has(\"$template\")" "$TEMPLATES_FILE")
    [[ "$tmpl_exists" == "true" ]] || die "Template '$template' not found"

    # Store display name
    save_display_name "$slot" "$display_name"

    # Switch to the target slot
    aerospace workspace "$slot"

    # Launch apps from template
    local app_count
    app_count=$(yq ".\"$template\".apps | length" "$TEMPLATES_FILE")

    # Resolve profiles upfront (shows picker before launching anything)
    declare -A resolved_profiles
    declare -A resolved_chrome_profiles
    for ((i = 0; i < app_count; i++)); do
        local ptag
        ptag=$(yq ".\"$template\".apps[$i].\"profile-tag\" // \"\"" "$TEMPLATES_FILE")
        if [[ -n "$ptag" ]]; then
            resolved_profiles[$i]=$(pick_iterm_profile "$ptag")
        fi

        local chrome_profile
        chrome_profile=$(yq ".\"$template\".apps[$i].\"chrome-profile\" // \"\"" "$TEMPLATES_FILE")
        if [[ -n "$chrome_profile" ]]; then
            resolved_chrome_profiles[$i]=$(resolve_chrome_profile "$chrome_profile")
        fi
    done

    for ((i = 0; i < app_count; i++)); do
        local entry_type
        entry_type=$(yq ".\"$template\".apps[$i] | type" "$TEMPLATES_FILE")

        local app_name
        local args=()
        local iterm_profile="${resolved_profiles[$i]:-}"
        local chrome_profile_dir="${resolved_chrome_profiles[$i]:-}"

        if [[ "$entry_type" == "!!str" ]]; then
            app_name=$(yq ".\"$template\".apps[$i]" "$TEMPLATES_FILE")
        else
            app_name=$(yq ".\"$template\".apps[$i].app" "$TEMPLATES_FILE")
            local args_count
            args_count=$(yq ".\"$template\".apps[$i].args | length // 0" "$TEMPLATES_FILE")
            for ((j = 0; j < args_count; j++)); do
                args+=("$(yq ".\"$template\".apps[$i].args[$j]" "$TEMPLATES_FILE")")
            done
        fi

        launch_app "$slot" "$app_name" "$iterm_profile" "$chrome_profile_dir" "${args[@]}"
    done

    aerospace workspace "$slot"
    log "Workspace '$display_name' launched in slot $slot."
}

if [[ "${1:-}" == "--resolve-chrome-profile" ]]; then
    resolve_chrome_profile "${2:?Usage: ws-launch --resolve-chrome-profile <display-name>}"
    exit $?
elif [[ "${1:-}" == "--list-chrome-profiles" ]]; then
    list_chrome_profiles
    exit $?
fi

main "$@"
