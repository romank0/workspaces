#!/usr/bin/env bash
# ABOUTME: Interactive workspace picker using choose-gui.
# ABOUTME: Switches to selected workspace or creates new ones from templates.

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
TEMPLATES_FILE="${TEMPLATES_FILE:-$REPO_DIR/templates/workspaces.yaml}"
CHOOSE_CMD="${CHOOSE_CMD:-choose}"
# shellcheck source=../lib/name-store.sh
source "$REPO_DIR/lib/name-store.sh"

declare -A display_names
load_display_names() {
    if [[ -f "$NAME_STORE" ]]; then
        while IFS='=' read -r slot name; do
            [[ -n "$slot" && -n "$name" ]] && display_names["$slot"]="$name"
        done < "$NAME_STORE"
    fi
}

PERSISTENT_SLOTS=("1" "2")

active_workspaces() {
    local windows_json
    windows_json=$(aerospace list-windows --all --json --format '%{workspace}' 2>/dev/null) || return

    local occupied_slots
    occupied_slots=$(echo "$windows_json" | jq -r '.[].workspace' | sort -u)

    # Always include persistent monitor workspaces, then occupied ones
    local all_slots
    all_slots=$(printf '%s\n' "${PERSISTENT_SLOTS[@]}" $occupied_slots | sort -u)

    echo "$all_slots" | while IFS= read -r slot; do
        local name="${display_names["$slot"]:-$slot}"
        echo "${slot}  ${name}"
    done
}

available_templates() {
    yq 'keys | .[]' "$TEMPLATES_FILE" 2>/dev/null
}

pick_slot() {
    local used_slots
    used_slots=$(aerospace list-windows --all --json --format '%{workspace}' 2>/dev/null \
        | jq -r '.[].workspace' | sort -u)

    local entries=""
    for slot in {1..9} {A..Z}; do
        if ! echo "$used_slots" | grep -qx "$slot"; then
            entries+="${slot}"$'\n'
        fi
    done

    echo -n "$entries" | $CHOOSE_CMD -p "Slot:" -n 10
}

build_entries() {
    local focused_slot="$1"
    local entries=""

    local active
    active=$(active_workspaces)
    if [[ -n "$active" ]]; then
        while IFS= read -r line; do
            local slot
            slot=$(echo "$line" | cut -d' ' -f1)
            local marker=" "
            if [[ "$slot" == "$focused_slot" ]]; then
                marker="*"
            fi
            entries+="${marker} ${line}"$'\n'
        done <<< "$active"
    fi

    # Rename option (when focused workspace has windows)
    if [[ -n "$active" ]] && echo "$active" | cut -d' ' -f1 | grep -qx "$focused_slot"; then
        entries+="~ Rename"$'\n'
    fi

    local templates
    templates=$(available_templates)
    if [[ -n "$templates" ]]; then
        while IFS= read -r tmpl; do
            entries+="+ New from ${tmpl}"$'\n'
        done <<< "$templates"
    fi

    entries+="+ Terminal"$'\n'

    echo -n "$entries"
}

handle_selection() {
    local selection="$1"
    local focused_slot="$2"

    if [[ "$selection" == "+ Terminal" ]]; then
        local slot
        slot=$(pick_slot) || exit 0
        slot=$(echo "$slot" | tr '[:lower:]' '[:upper:]')

        local name
        name=$(echo "Terminal" | $CHOOSE_CMD -m -p "Name:" -e) || exit 0
        name="${name:-Terminal}"

        save_display_name "$slot" "$name"
        aerospace workspace "$slot"
        osascript -e 'tell application "iTerm" to create window with default profile' 2>/dev/null
        "$REPO_DIR/bin/ws-sync"

    elif [[ "$selection" == "~ Rename" ]]; then
        local current_name="${display_names["$focused_slot"]:-}"
        local new_name
        new_name=$(echo "$current_name" | $CHOOSE_CMD -m -p "Name:" -e) || exit 0
        [[ -n "$new_name" ]] || exit 0

        save_display_name "$focused_slot" "$new_name"
        "$REPO_DIR/bin/ws-sync"

    elif [[ "$selection" =~ ^\+\ New\ from\ (.+)$ ]]; then
        local template="${BASH_REMATCH[1]}"

        local slot
        slot=$(pick_slot) || exit 0
        slot=$(echo "$slot" | tr '[:lower:]' '[:upper:]')

        local name
        name=$(echo "$template" | $CHOOSE_CMD -m -p "Name:" -e) || exit 0
        name="${name:-$template}"

        "$REPO_DIR/bin/ws-launch" "$template" "$slot" "$name"

    elif [[ "$selection" =~ ^[*\ ]\ ([^ ]+) ]]; then
        local slot="${BASH_REMATCH[1]}"
        aerospace workspace "$slot"
    fi
}

main() {
    aerospace list-workspaces --focused >/dev/null 2>&1 || exit 1

    if [[ "$CHOOSE_CMD" == "choose" ]]; then
        command -v choose >/dev/null 2>&1 || exit 1
    fi

    load_display_names

    local focused_slot
    focused_slot=$(aerospace list-workspaces --focused 2>/dev/null || true)

    local entries
    entries=$(build_entries "$focused_slot")

    [[ -z "$entries" ]] && exit 0

    if [[ "${1:-}" == "--list" ]]; then
        echo -n "$entries"
        exit 0
    fi

    local selection
    selection=$(echo -n "$entries" | $CHOOSE_CMD -p "Workspace:" -n 12) || exit 0

    handle_selection "$selection" "$focused_slot"
}

main "$@"
