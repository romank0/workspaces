#!/usr/bin/env bash
# ABOUTME: Interactive workspace picker using fzf in an iTerm2 popup.
# ABOUTME: Supports switching to active workspaces and creating new ones from templates.

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
TEMPLATES_FILE="$REPO_DIR/templates/workspaces.yaml"
NAME_STORE="$HOME/.local/state/workspaces/names"

die() { printf 'ERROR: %s\n' "$*" >&2; sleep 2; exit 1; }

declare -A display_names
load_display_names() {
    if [[ -f "$NAME_STORE" ]]; then
        while IFS='=' read -r slot name; do
            [[ -n "$slot" && -n "$name" ]] && display_names["$slot"]="$name"
        done < "$NAME_STORE"
    fi
}

get_focused_slot() {
    aerospace list-workspaces --focused 2>/dev/null || true
}

active_workspaces() {
    local windows_json
    windows_json=$(aerospace list-windows --all --json --format '%{workspace}' 2>/dev/null) || return

    echo "$windows_json" | jq -r '.[].workspace' | sort -u | while IFS= read -r slot; do
        local name="${display_names["$slot"]:-}"
        if [[ -n "$name" ]]; then
            echo "switch:${slot}:${name}"
        else
            echo "switch:${slot}:${slot}"
        fi
    done
}

available_templates() {
    yq 'keys | .[]' "$TEMPLATES_FILE" 2>/dev/null | while IFS= read -r tmpl; do
        echo "create:${tmpl}"
    done
}

next_available_slot() {
    local used_slots
    used_slots=$(aerospace list-windows --all --json --format '%{workspace}' 2>/dev/null \
        | jq -r '.[].workspace' | sort -u)

    for slot in {1..9} {A..Z}; do
        if ! echo "$used_slots" | grep -qx "$slot"; then
            echo "$slot"
            return
        fi
    done
    die "No available slots"
}

do_switch() {
    local slot="$1"
    # Switch in background so the picker window closing doesn't bounce focus back
    nohup aerospace workspace "$slot" &>/dev/null &
}

do_create() {
    local template="$1"

    local default_slot
    default_slot=$(next_available_slot)

    echo ""
    printf "Slot [%s]: " "$default_slot" > /dev/tty
    read -r slot < /dev/tty
    slot="${slot:-$default_slot}"
    slot=$(echo "$slot" | tr '[:lower:]' '[:upper:]')

    printf "Name [%s]: " "$template" > /dev/tty
    read -r name < /dev/tty
    name="${name:-$template}"

    echo "" > /dev/tty
    echo "Creating workspace '$name' in slot $slot from template '$template'..." > /dev/tty
    "$REPO_DIR/bin/ws-launch" "$template" "$slot" "$name"
}

main() {
    aerospace list-workspaces --focused >/dev/null 2>&1 || die "Aerospace is not running"
    command -v fzf >/dev/null 2>&1 || die "fzf not found"

    load_display_names

    local focused_slot
    focused_slot=$(get_focused_slot)

    # Build menu entries
    local entries=""

    local active
    active=$(active_workspaces)
    if [[ -n "$active" ]]; then
        while IFS= read -r line; do
            local slot name
            slot=$(echo "$line" | cut -d: -f2)
            name=$(echo "$line" | cut -d: -f3)
            local marker=" "
            if [[ "$slot" == "$focused_slot" ]]; then
                marker="*"
            fi
            entries+="${marker} ${slot}  ${name}"$'\n'
        done <<< "$active"
    fi

    local templates
    templates=$(available_templates)
    if [[ -n "$templates" ]]; then
        entries+="─────────────────"$'\n'
        while IFS= read -r line; do
            local tmpl
            tmpl=$(echo "$line" | cut -d: -f2)
            entries+="  +  New from ${tmpl}"$'\n'
        done <<< "$templates"
    fi

    if [[ -z "$entries" ]]; then
        die "No workspaces or templates found"
    fi

    local selection
    selection=$(echo -n "$entries" | fzf \
        --reverse \
        --no-sort \
        --no-info \
        --select-1 \
        --header="Switch or create workspace" \
        --header-first) || exit 0

    if [[ "$selection" =~ ^─ ]]; then
        exit 0
    elif [[ "$selection" =~ ^\ \ \+\ \ New\ from\ (.+)$ ]]; then
        local template="${BASH_REMATCH[1]}"
        do_create "$template"
    elif [[ "$selection" =~ ^.\ ([^ ]+)\ \ (.+)$ ]]; then
        local slot="${BASH_REMATCH[1]}"
        do_switch "$slot"
    fi
}

main "$@"
