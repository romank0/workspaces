#!/usr/bin/env bash
# ABOUTME: Syncs Aerospace workspace state to SketchyBar items.
# ABOUTME: Shows only occupied or focused workspaces with display names from the name store.

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
ITEM_PREFIX="ws"
NAME_STORE="$HOME/.local/state/workspaces/names"

SLOT_ORDER="${WS_SLOT_ORDER:-1234567890QWERTYUIOPASDFGHJKLZXCVBNM}"
COLOR_ALERT="0xffe0af68"
COLOR_OCCUPIED="0xffcdd6f4"
BG_DEFAULT="0x00000000"

# Bail if aerospace is not running
if ! aerospace list-workspaces --focused >/dev/null 2>&1; then
    exit 0
fi

# Load display names from store
declare -A display_names
if [[ -f "$NAME_STORE" ]]; then
    while IFS='=' read -r slot name; do
        [[ -n "$slot" && -n "$name" ]] && display_names["$slot"]="$name"
    done < "$NAME_STORE"
fi

STATE_DIR="${WS_ALERT_STATE_DIR:-$HOME/.local/state/workspaces}"
ALERT_DIR="$STATE_DIR/alerts"
declare -A alert_slots
if [[ -d "$ALERT_DIR" ]]; then
    for f in "$ALERT_DIR"/*; do
        [[ -f "$f" ]] && alert_slots["$(basename "$f")"]=1
    done
fi

# Get all workspaces with focus/visibility info
workspaces_json=$(aerospace list-workspaces --all --json \
    --format '%{workspace}%{tab}%{workspace-is-focused}%{tab}%{workspace-is-visible}')

# Get window counts per workspace
windows_json=$(aerospace list-windows --all --json \
    --format '%{workspace}%{tab}%{window-id}')

declare -A window_counts
while IFS= read -r line; do
    ws=$(echo "$line" | jq -r '.workspace')
    window_counts["$ws"]=$(( ${window_counts["$ws"]:-0} + 1 ))
done < <(echo "$windows_json" | jq -c '.[]' 2>/dev/null)

# Remove then recreate in a single sketchybar call to avoid flicker
args=(--remove '/^ws\./')
while IFS= read -r line; do
    slot=$(echo "$line" | jq -r '.workspace')
    is_focused=$(echo "$line" | jq -r '.["workspace-is-focused"]')
    count=${window_counts["$slot"]:-0}

    # Always show monitor workspaces (1=main, 2=secondary); skip other empty unfocused ones
    if [[ "$count" -eq 0 && "$is_focused" != "true" && "$slot" != "1" && "$slot" != "2" ]]; then
        continue
    fi

    item_name="${ITEM_PREFIX}.${slot}"
    display_name="${display_names["$slot"]:-}"

    if [[ -n "${alert_slots["$slot"]:-}" ]]; then
        icon_color="$COLOR_ALERT"
    else
        icon_color="$COLOR_OCCUPIED"
    fi

    if [[ "$is_focused" == "true" ]]; then
        bg_color="${icon_color/ff/40}"
        bg_drawing="on"
    else
        bg_color="$BG_DEFAULT"
        bg_drawing="off"
    fi

    label=""
    if [[ -n "$display_name" ]]; then
        label="$display_name"
    fi

    args+=(
        --add item "$item_name" left
        --set "$item_name"
            icon="$slot"
            icon.color="$icon_color"
            label="$label"
            label.color="$icon_color"
            label.font="SF Pro:Semibold:13.0"
            background.drawing="$bg_drawing"
            background.color="$bg_color"
            background.corner_radius=4
            background.height=24
            padding_left=2
            padding_right=2
            click_script="aerospace workspace $slot"
    )
done < <(echo "$workspaces_json" | jq -c --arg order "$SLOT_ORDER" \
    '[.[] | .workspace as $w | . + {"_idx": ($order | index($w) // 999)}] | sort_by(._idx) | .[]')

sketchybar "${args[@]}" 2>/dev/null || true
